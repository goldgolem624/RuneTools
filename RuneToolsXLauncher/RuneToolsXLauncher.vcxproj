      <AdditionalDependencies>Ultralight.lib;UltralightCore.lib;WebCore.lib;AppCore.lib;Psapi.lib;Shell32.lib;Bcrypt.lib;Crypt32.lib;Winhttp.lib;CacheVendor.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(SolutionDir)$(Platform)\$(Configuration)\;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <DelayLoadDLLs>Ultralight.dll;UltralightCore.dll;WebCore.dll;AppCore.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
    </Link>
    <PostBuildEvent>
      <Command>if exist "$(ProjectDir)..\stage-sdk.ps1" powershell -NoProfile -ExecutionPolicy Bypass -File "$(ProjectDir)..\stage-sdk.ps1" -OutFile "$(TargetDir)plugin-sdk.js"</Command>
