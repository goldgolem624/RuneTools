  <!--
    Stage runtime artifacts next to the exe so the build output is
    launchable without manual copying. AfterTargets="Build" so it
    fires even when Link is skipped on an unchanged source tree.
  -->
  <Target Name="StageRuntime" AfterTargets="Build">
    <ItemGroup>
      <UltralightDlls Include="$(UltralightDir)\bin\*.dll" />
      <UltralightRes  Include="$(UltralightDir)\resources\*" />
      <UltralightLic  Include="$(UltralightDir)\license\*" />
      <AlertSounds    Include="$(ProjectDir)..\ui-assets\sounds\*" />
      <PanelScripts   Include="$(ProjectDir)..\ui-assets\panel_*.js" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)Ultralight" />
    <MakeDir Directories="$(OutDir)Ultralight\resources" />
    <MakeDir Directories="$(OutDir)Ultralight\license" />
    <Copy SourceFiles="@(UltralightDlls)"
          DestinationFolder="$(OutDir)Ultralight"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(UltralightRes)"
          DestinationFolder="$(OutDir)Ultralight\resources"
          SkipUnchangedFiles="true" />
    <!-- Ultralight licence terms ship beside the runtime: the SDK licence requires the
         EULA to govern end-user distribution and NOTICES to accompany the product. -->
    <Copy SourceFiles="@(UltralightLic)"
          DestinationFolder="$(OutDir)Ultralight\license"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)..\ui-assets\launcher.html"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(ProjectDir)..\ui-assets\client.html"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(ProjectDir)..\ui-assets\quest_guides.js"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true"
          Condition="Exists('$(ProjectDir)..\ui-assets\quest_guides.js')" />
    <Copy SourceFiles="@(PanelScripts)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true"
          Condition="'@(PanelScripts)' != ''" />
    <MakeDir Directories="$(OutDir)sounds" />
    <Copy SourceFiles="@(AlertSounds)"
          DestinationFolder="$(OutDir)sounds"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <!-- src\node_modules is the rsmv DEV install (electron etc., ~400MB); the shipped
           runtime is node.exe + the root node_modules + dist. Staging it once ballooned
           the installer 85MB -> 188MB. -->
      <Cs2Sidecar Include="$(ProjectDir)..\ThirdParty\cs2sidecar\**\*"
                  Exclude="$(ProjectDir)..\ThirdParty\cs2sidecar\src\node_modules\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(Cs2Sidecar)"
          DestinationFiles="@(Cs2Sidecar->'$(OutDir)cs2sidecar\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(Cs2Sidecar)' != ''" />
    <Copy SourceFiles="$(ProjectDir)..\ui-assets\items.pack"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ProjectDir)..\ui-assets\items.pack')" />
    <Copy SourceFiles="$(ProjectDir)..\ui-assets\wd_table.bin"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ProjectDir)..\ui-assets\wd_table.bin')" />
    <Copy SourceFiles="$(ProjectDir)..\ui-assets\pdb_5554.bin"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ProjectDir)..\ui-assets\pdb_5554.bin')" />
    <Message Text="Staged Ultralight runtime + launcher.html + alert sounds next to $(TargetName).exe"
             Importance="high" />
  </Target>

  <!--
    Auto-build the Inno Setup installer once the runtime payload is staged, so
    installer\Output\RuneToolsXSetup.exe always matches the freshly built exe
    (no more uploading a stale setup.exe). Release|x64 only; the .iss bundles
    ..\x64\Release. Incremental: the Inputs/Outputs pair skips this when the
    setup.exe is already newer than the exe/dll/UI assets/.iss, so unchanged
    rebuilds pay nothing. If Inno Setup isn't installed it warns and skips (the
    solution still builds). Auto-discovers ISCC.exe (per-user install dir, then
    Program Files, then the registry); override with the ISCC property.
  -->
  <Target Name="BuildInstaller" AfterTargets="StageRuntime"
          Condition="'$(Configuration)|$(Platform)'=='Release|x64'"
          Inputs="$(OutDir)RuneToolsXLauncher.exe;$(OutDir)rtxscene.dll;$(ProjectDir)..\ui-assets\launcher.html;$(ProjectDir)..\ui-assets\client.html;$(ProjectDir)..\ui-assets\quest_guides.js;$(ProjectDir)..\ui-assets\panel_*.js;$(ProjectDir)..\ui-assets\items.pack;$(ProjectDir)..\ui-assets\wd_table.bin;$(ProjectDir)..\ui-assets\pdb_5554.bin;$(ProjectDir)..\installer\RuneToolsX.iss"
          Outputs="$(ProjectDir)..\installer\Output\RuneToolsXSetup.exe">
    <PropertyGroup>
      <ISCC Condition="'$(ISCC)'=='' And Exists('$(LocalAppData)\Programs\Inno Setup 6\ISCC.exe')">$(LocalAppData)\Programs\Inno Setup 6\ISCC.exe</ISCC>
      <ISCC Condition="'$(ISCC)'=='' And Exists('$(MSBuildProgramFiles32)\Inno Setup 6\ISCC.exe')">$(MSBuildProgramFiles32)\Inno Setup 6\ISCC.exe</ISCC>
      <ISCC Condition="'$(ISCC)'=='' And Exists('$(ProgramW6432)\Inno Setup 6\ISCC.exe')">$(ProgramW6432)\Inno Setup 6\ISCC.exe</ISCC>
      <_InnoDir Condition="'$(ISCC)'==''">$([MSBuild]::GetRegistryValueFromView('HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Inno Setup 6_is1', 'InstallLocation', null, RegistryView.Registry64, RegistryView.Registry32))</_InnoDir>
      <ISCC Condition="'$(ISCC)'=='' And '$(_InnoDir)'!='' And Exists('$(_InnoDir)ISCC.exe')">$(_InnoDir)ISCC.exe</ISCC>
      <IssFile>$(ProjectDir)..\installer\RuneToolsX.iss</IssFile>
    </PropertyGroup>
    <Warning Condition="'$(ISCC)'==''"
             Text="Inno Setup (ISCC.exe) not found -- skipping installer build. Install Inno Setup 6 or pass -p:ISCC=&lt;path&gt; to auto-build RuneToolsXSetup.exe." />
    <Message Condition="'$(ISCC)'!=''" Importance="high" Text="Compiling installer: $(ISCC)" />
    <Exec Condition="'$(ISCC)'!=''"
          Command="&quot;$(ISCC)&quot; /Q &quot;$(IssFile)&quot;"
          WorkingDirectory="$(ProjectDir)..\installer" />
    <Message Condition="'$(ISCC)'!=''" Importance="high"
             Text="Installer built -> $(ProjectDir)..\installer\Output\RuneToolsXSetup.exe" />
  </Target>
</Project>
