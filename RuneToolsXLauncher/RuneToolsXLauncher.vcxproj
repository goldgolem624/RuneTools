    <IntDir>$(SolutionDir)$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
    <TargetName>RuneToolsXLauncher</TargetName>
    <!-- Path to the Ultralight 1.4 SDK. Defaults to ThirdParty\Ultralight in the
         repo root; override this property (or place the SDK there) to build. -->
    <UltralightDir>$(ProjectDir)..\ThirdParty\Ultralight</UltralightDir>
    <IncludePath>$(UltralightDir)\include;$(IncludePath)</IncludePath>
    <LibraryPath>$(UltralightDir)\lib;$(LibraryPath)</LibraryPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
