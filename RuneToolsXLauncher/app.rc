#include <windows.h>

// 1 = lowest numeric id so Explorer picks this as the file icon.
1 ICON "app.ico"

// Version resource -- the ONLY place the app version lives. The FIXEDFILEINFO FILEVERSION
// drives everything (running_version() reads it; the installer (RuneToolsX.iss) derives its
// MyAppVersion from this exe via GetFileVersion, and the server extracts the manifest version
// from that installer). But bump ALL FOUR fields together every release -- FILEVERSION and
// PRODUCTVERSION (comma form) AND the "FileVersion"/"ProductVersion" strings below -- so the
// binary and its file-properties display never disagree.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,7,7,0
 PRODUCTVERSION 1,7,7,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RuneTools"
            VALUE "FileDescription",  "RuneTools"
            VALUE "FileVersion",      "1.7.7.0"
            VALUE "InternalName",     "RuneToolsXLauncher"
            VALUE "OriginalFilename", "RuneToolsXLauncher.exe"
            VALUE "ProductName",      "RuneTools"
            VALUE "ProductVersion",   "1.7.7.0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 RuneTools"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
